{% extends '/layouts/base.html.twig' %}

{% block title %}Vos Personnages - GODS
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<!-- Votre CSS partagé -->
	<link rel="stylesheet" href="/css/tailwind.css">
{% endblock %}

{% block body %}
	<!-- Point de montage -->
	<div id="characters-root" data-characters='{{ characters|json_encode|e("html_attr") }}'></div>

	<!-- On place le script ICI, directement dans le body, comme pour login.html.twig -->
	<script type="module" src="/js/characters.js"></script>
{% endblock %}
