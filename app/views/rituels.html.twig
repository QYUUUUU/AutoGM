{% extends '/layouts/base.html.twig' %}

{% block title %}Rituels - GODS
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="/css/dashboard.css">
	<style>
		/* Forcefully hide the global footer if necessary */
		#gods-footer-root {
			display: none !important;
		}
	</style>
{% endblock %}

{% block body %}
	<!-- React Mount Point -->
	<div id="gods-rituals-root" class="gods:w-full gods:overflow-hidden gods:bg-background gods:text-foreground gods:border-t gods:border-border" style="margin-top: 64px; height: calc(100vh - 64px);"></div>

	<!-- Data Injection -->
	<script id="gods-rituals-data" type="application/json">
		{
					"characters":
		{{ characters | json_encode | raw }}
		}
	</script>

	<!-- React Application -->
	<script type="module" src="/js/rituals.js"></script>
{% endblock %}
