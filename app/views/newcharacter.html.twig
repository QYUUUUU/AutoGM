{% extends '/layouts/base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}

	{# 
		       En production, Vite génère un fichier CSS portant le nom de l'entrée.
		       Assurez-vous de le charger ici si vous n'utilisez pas de loader dynamique.
		    #}

{% endblock %}

{% block body %}
	{# Le conteneur où React va "monter" l'application #}
	<div id="character-creation-root"></div>

	{# L'injection des données dynamiques venant de votre backend vers React #}
	<script id="character-creation-data" type="application/json">
		{
				            "equipmentList":
		{{ equipment|default('[]')|json_encode|raw }}
		}
	</script>

	{# L'import de votre fichier main.tsx selon l'environnement #}
	{% if app.environment == 'dev' %}
		{# En mode développement, on pointe vers le serveur Vite local #}
		<script type="module" src="http://localhost:5173/src/create_character/main.tsx"></script>
	{% else %}
		{# En production, on pointe vers le fichier généré par votre build #}
		<script type="module" src="/js/create_character.js"></script>
	{% endif %}
{% endblock %}
