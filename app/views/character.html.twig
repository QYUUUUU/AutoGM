{% extends '/layouts/base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="/css/character_sheet.css">
{% endblock %}

{% block body %}
	<div id="gods-character-root"></div>

	<script id="gods-character-data" type="application/json">
		{{ {
			character: character
		} | json_encode | raw }}
	</script>

	<script type="module" src="/js/character_sheet.js"></script>
{% endblock %}
