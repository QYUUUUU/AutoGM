{% extends '/layouts/base.html.twig' %}

{% block title %}Mon Assistant - GODS
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="/css/dashboard.css">
	<style>
		/* Forcefully hide the global footer injected by chrome.js */
		#gods-footer-root {
			display: none !important;
		}
	</style>
{% endblock %}

{% block body %}
	<!-- 1. React Mount Point -->
	<!-- margin-top: 64px matches the h-16 of Header.tsx -->
	<!-- gods:border-t gods:border-border creates the discreet line! --><div id="gods-dashboard-root" class="gods:w-full gods:overflow-hidden gods:bg-background gods:text-foreground gods:border-t gods:border-border" style="margin-top: 64px; height: calc(100vh - 64px);"> </div>

	<!-- 2. Legacy 3D Physics Canvas -->
	<div id="ThreeJS" style="position: fixed; top: 0; left: 0; pointer-events: none; z-index: 1000; width: 100vw; height: 100vh;"></div>

	<!-- 3. THE LEGACY TRAP: Prevents bundle.js from crashing -->
	<div id="legacy-trap" style="display: none;" aria-hidden="true">
		<button id="dice-throw-trigger"></button>
		<input id="dice-input" type="text"/>
		<input id="modifier"/>
		<button id="increment"></button>
		<button id="decrement"></button>
		<button id="stats-send"></button>
		<input id="dropdown-input"/>
		<div id="dropdown"></div>
		<input id="caracteristic-input"/>
		<div id="caracteristic-dropdown"></div>
		<select id="favoriteCharacter"></select>
		<select id="armeSelect"></select>
		<select id="armureSelect"></select>
	</div>

	<!-- 4. Data Injection -->
	<script id="gods-dashboard-data" type="application/json">
		{
		        "character":
		{{ favoriteCharacter.character | json_encode | raw }},
		        "characters":
		{{ characters | json_encode | raw }},
		        "equipmentList":
		{{ equipmentList | default('[]') | json_encode | raw }},
		        "allGroupes":
		{{ allGroupes | default('[]') | json_encode | raw }},
		        "conversationId":
		{{ conversation.id | default('null') | json_encode | raw }}
		}
	</script>

	<!-- 5. Legacy Scripts -->
	<script src="/js/bundle.js"></script>

	<!-- 6. React Application -->
	<script type="module" src="/js/dashboard.js"></script>
{% endblock %}
