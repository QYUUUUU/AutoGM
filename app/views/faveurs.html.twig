{% extends '/layouts/base.html.twig' %}

{% block title %}Faveurs Divines | GODS
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		/* Forcefully hide the global footer so the full-height flex layout works */
		#gods-footer-root {
			display: none !important;
		}
	</style>
{% endblock %}

{% block body %}
	<!-- 1. React Mount Point -->
	<div id="gods-faveurs-root"></div>

	<!-- 2. Data Injection for the React App -->
	<script id="gods-faveurs-data" type="application/json">
		{
		            "faveurs":
		{{ faveurs | default('[]') | json_encode | raw }},
		            "characters":
		{{ characters | default('[]') | json_encode | raw }}
		}
	</script>

	<!-- 3. React Application Script -->
	<script type="module" src="/js/faveurs.js"></script>
{% endblock %}
