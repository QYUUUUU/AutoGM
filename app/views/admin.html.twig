{% extends '/layouts/base.html.twig' %}

{% block title %}Dashboard MJ - GODS
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="/css/admin_dashboard.css">

	<style>
		/* Forcefully hide the global footer injected by chrome.js */
		#gods-footer-root {
			display: none !important;
		}
	</style>
{% endblock %}

{% block body %}
	<div id="gods-admin-dashboard-root" class="gods:w-full gods:overflow-hidden gods:bg-background gods:text-foreground" style="margin-top:64px;height:calc(100vh - 64px);"></div>

	<script id="gods-admin-dashboard-data" type="application/json">
		{{ {
            activeGroupeId: activeGroupeId|default(null),
            groupes: groupes|default([]),
            worldState: worldState|default({}),
            characters: characters|default([]),
            equipment: equipment|default([]),
            adversaries: adversaries|default([])
        }|json_encode|raw }}
	</script>

	{# Ce script reste volontairement séparé : il remplit .dice-results/.body-card. #}
	<script src="/js/dashboardTrackRolls.js"></script>
	<script type="module" src="/js/admin_dashboard.js"></script>
{% endblock %}
